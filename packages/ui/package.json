{
  "name": "@rk/ui",
  "private": true,
  "type": "module",
  "exports": {
    "./primitive": {
      "types": "./src/primitive/index.ts",
      "default": "./src/primitive/index.ts"
    },
    "./react": {
      "types": "./src/react/index.ts",
      "default": "./src/react/index.ts"
    },
    "./global.css": {
      "types": "./src/style/global.css",
      "default": "./src/style/global.css"
    }
  },
  "scripts": {
    "lint": "pnpm run lint:fix && oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ui-sdk/core": "0.1.0-beta.10",
    "@ui-sdk/react": "0.1.0-beta.10",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  }
}
