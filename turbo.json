{
  "$schema": "./node_modules/turbo/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["out/**", "dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "format": {},
    "format:check": {},
    "lint": {},
    "lint:fix": {},
    "package": {
      "dependsOn": ["build"],
      "cache": false
    },
    "package:linux": {
      "dependsOn": ["build"],
      "cache": false
    },
    "package:mac": {
      "dependsOn": ["build"],
      "cache": false
    },
    "package:win": {
      "dependsOn": ["build"],
      "cache": false
    },
    "test": {},
    "typecheck": {},
    "//#lint:root": {},
    "//#typecheck:root": {}
  }
}
